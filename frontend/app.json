{
  "expo": {
    "name": "BharatYatra",
    "slug": "bharatyatra",
    "version": "0.1.1",
    "orientation": "portrait",
    "scheme": "bharatyatra",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D47A1"
    },
    "android": {
      "package": "com.bharatyatra.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D47A1"
      }
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
