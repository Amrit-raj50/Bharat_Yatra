{
  "expo": {
    "name": "BharatYatra",
    "slug": "bharatyatra",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "bharatyatra",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0D47A1"
    },
    "android": {
      "package": "com.bharatyatra.app"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
